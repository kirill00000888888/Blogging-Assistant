# Copy to .env in this folder (or use repo-root tokens_env/tokens.env — loaded automatically).
HF_TOKEN=hf_your_token_here

# From @BotFather (Telegram). Also accepts BOT_TOKEN.
# TELEGRAM_BOT_TOKEN=

# Optional: any model that supports chat via HF Inference Providers
# See https://huggingface.co/models?inference_provider=all
HF_MODEL=moonshotai/Kimi-K2-Instruct-0905

PORT=3000

# Optional: abort Hugging Face request after N ms (default 120000)
# HF_TIMEOUT_MS=120000

# Optional: max new tokens from model (default 1024). Lower = faster/shorter; 512 often cuts off lists.
# HF_MAX_TOKENS=1536

# Optional: set to 0 to disable SSE streaming (use if you see "fetch failed" or empty stream)
# HF_STREAM=0
