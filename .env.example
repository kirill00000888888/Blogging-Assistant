# Copy this file to .env in the project folder.
# The app also loads ../tokens_env/tokens.env and
# ../huggingface_token/huggingface_token.env if you prefer external secrets.

# Required for web chat and Telegram bot AI replies.
HF_TOKEN=hf_your_token_here

# Hugging Face OpenAI-compatible router.
HF_CHAT_URL=https://router.huggingface.co/v1/chat/completions

# Any model available through HF Inference Providers and chat completions.
HF_MODEL=moonshotai/Kimi-K2-Instruct-0905

# Web server.
PORT=3000

# Web admin panel authorization.
# Change these values before demonstration or deployment.
WEB_ADMIN_LOGIN=admin
WEB_ADMIN_PASSWORD=admin
WEB_SESSION_SECRET=change_this_long_random_value

# Streaming is off by default for better compatibility with HF providers.
# Set to 1/true/on only if your selected model streams correctly.
HF_STREAM=0

# Hugging Face request timeout and answer length.
HF_TIMEOUT_MS=120000
HF_MAX_TOKENS=3072
HF_TEMPERATURE=0.45
HF_RETRY_QUALITY=1

# Keeps the diploma demo working if Hugging Face credits are depleted.
# Set to 0 to disable local template replies.
LOCAL_FALLBACK=1

# Web API safety limits.
CHAT_MAX_MESSAGES=30
CHAT_MAX_MESSAGE_CHARS=4000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=25

# Use 1/true only when the app is behind a trusted reverse proxy.
TRUST_PROXY=0

# Telegram bot. From @BotFather. BOT_TOKEN is also accepted.
TELEGRAM_BOT_TOKEN=
TG_MAX_DIALOG_MESSAGES=24
TG_HANDLER_EXTRA_MS=120000
TG_HF_TIMEOUT_MS=180000
TG_HF_MAX_TOKENS=2048

# Persistent Telegram user/session storage.
BOT_STORAGE_FILE=

# Empty means public bot. To restrict access, list Telegram IDs:
# ALLOWED_TELEGRAM_IDS=123456789,987654321
ALLOWED_TELEGRAM_IDS=
